# Base de datos (local: postgres://localhost/radar_urbano; Supabase: modo sesión, puerto 5432)
DATABASE_URL=postgres://localhost/radar_urbano
DATABASE_URL_TEST=postgres://localhost/radar_urbano_test
# Opcional: certificado raíz de Supabase (PEM; \n escapados valen) para verificar TLS. Vacío = TLS sin verificar.
DATABASE_CA_CERT=
# Conexiones por proceso (Railway: web 5, worker 3; el pooler de sesión cuenta cada una)
DATABASE_POOL_MAX=10

# Jev (TypeSafe)
TYPESAFE_API_KEY=

# LLM compatible con OpenAI (DeepSeek por defecto). El modelo efectivo sale de la política; LLM_MODEL es el respaldo.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Sesiones internas (iron-session, ≥ 32 caracteres)
SESSION_SECRET=

# Storage de fotos: local | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=report-photos

# Geocodificación (Nominatim exige User-Agent identificable)
NOMINATIM_USER_AGENT=RadarUrbano/0.1 (contacto del equipo)

# Contraseñas de cuentas de demo (seed-demo falla si faltan)
DEMO_OPERATOR_PASSWORD=
DEMO_UNIT_PASSWORD=
